// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          engineGeometry;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

engineType      crankConRod;

rpm             1500;

bore            0.13;

stroke          0.157;

clearance       0.00125;

conRodLength    0.289;

engineMesh      fvMotionSolver;

component       z;

dynamicMesh     true; // To activate dynamicFvMesh functionality on top, e.g.,
                      // for canted-valve support - not yet implemented, hence,
                      // the canted-valve-dedicated solver 'NYTRO_engineFoam'
                      // and the respective mesh mover 'NYTRO_moveEngineMesh
                      // always use dynamicMesh capabilities at the moment.

diffusivityModel1 quadratic inverseDistance 1 ("piston|cylinderHead|valves.*");
diffusivityModel2 quadratic inverseDistance 1 ("piston");
diffusivityModel3 quadratic inverseDistance 1 ("cylinderHead|valves.*");

#include diffusivityDict

