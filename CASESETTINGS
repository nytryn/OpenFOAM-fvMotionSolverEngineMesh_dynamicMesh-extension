# --- CASE SETTINGS ------------------------------------------------------------
# --- Mode of operation:
# <operation>:              The automated operation to perform
#   |-> "case" -----------> Establish the basic case structure
#   |-> "geometry" -------> Assemble the engine geometry
#   |-> "engineTiming" ---> Perform kinematic engine timing analysis incl.
#   |                       valve-piston collision test based on STL geometry
#   |-> "meshDev" -------> Create FVM test mesh at valve-overlap crank angle
#   |                       position for CFD model develpment
#   |-> "compRatio" ------> Compute the engine compression ratio using STL-based
#   |                       FVM meshes
#   |-> "QETRMeshSeries" -> Generate moving-engine Quality-Event Triggered Re-
#   |                       meshing-based CFD grid series
#   |-> "QETRColdCycle" --> Compute moving-engine cold-flow (without combustion)
#   |-> "fullCycle" ------> Compute full moving-engine cycle (flow including
#   |                       combustion)
#   '-> "steadyState" --->  Perform cylinder head blow test for quasi-steady-
#                           state flow parameter evaluation
# <CA_start> [°CA]:         Transient reference crank angle (integer value). On-
#   '-> {0 ... 720}         ly effective for QETR or steady-state flow cases.
#                             * If <operation> == "QETR*": The starting crank
#                               angle of the transient computation
#                             * If <operation> == "steadyState": The reference
#                               crank angle used to determine the quasi-steady
#                               valve lift, read from the valve lift profiles
# <CA_range>:               Crank angle range of the flow computation
# <CFL_max> [-]:            The maximum allowed CFL (Courant-Friedrichs-Lewy)
#   |                       number of the flow (ensured via dynamic time-step
#   |                       adapation by the flow solver):
#   |                                   CFL = Uref * Δt / Δx
#   |                           Ux: Velocity in direction x
#   |                           Δt: Time-step size
#   |                           Δx: Grid step size (node distance)
#   |                       The following intervals are based on anecdotal ex-
#   |                       perience only and may differ casewise:
#   |-> CFL << 1 ---------> In general, very stable and very accurate, very slow
#   |-> CFL < 1 ----------> In general, stable and accurate, slow
#   |-> 1 < CFL < 2 ------> In general, stable but less accurate, faster
#   |-> 2 < CFL < 4 ------> In general, stable but potentially inaccurate, fast
#   '-> 4 < CFL ----------> Potentially unstable and/or inaccurate, very fast
# <doRestart>:              Whether to restart from a preceding case (must have
#   '-> true/false          identical geometry/engine) using <CA_start> as the
#                           restart starting crank angle when running QETR.
# <restartFrom>:            Path string pointing to the restart source case
# <restartCA>:              Restart crank angle (must exist in source case)
operation="QETRColdCycle"
symmetricDomain=true
CA_start=582
CA_end=1080
CFL_max=128
CFL_max_inj=3
stabilised=true
deltaT_init=1e-4 # taken as initial deltaCA by engine solvers
deltaT_init_inj=1e-4
deltaT_write=1
deltaT_max=0.1
deltaT_max_inj=0.01
writeFrequency_min=1
adjustTimeStep=true
#
doRestart=true
restartFrom="/media/lichtmes/DATA/test/20240318_080955_QETRColdCycle/RUN"
absorbRestartCase=false # Time directories < CA_restart + postProcessing
CA_restart=$CA_start
#
