FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          meshDict;
}

surfaceFile         "./GEOMETRY/DOMAIN.stl";
maxCellSize         0.0016;
boundaryCellSize    0.0008;
enforceConstraints  false;

localRefinement
{
}

anisotropicSources
{
}

objectRefinements
{
}

surfaceMeshRefinement
{
    /* -> Makes mesh dev fail -> how implement?
    AMR_fuel
    {
        surfaceFile                 "./GEOMETRY/fuel.stl";
        additionalRefinementLevels  2;
        refinementThickness         0;
    }*/
}

boundaryLayers
{
    nLayers 1;
    thicknessRatio  1.2;

    nLayers_wall    3;
    nLayers_wall_cylinderHead   $nLayers_wall;
    nLayers_wall_valvesIntake   $nLayers_wall;
    nLayers_wall_valvesExhaust  $nLayers_wall;
    nLayers_wall_piston         $nLayers_wall;
    patchBoundaryLayers
    {
        ".*_WALL.*"
        {
            nLayers         $nLayers_wall;
            maxFirstLayerThickness 0.0005;
            allowDiscontinuity true;
        }
        ".*TOPLAND.*|.*GASKET.*|.*PISTONRING.*"
        {
            nLayers         1;
            allowDiscontinuity true;
        }
        "PISTON_WALL.*"
        {
            nLayers         $nLayers_wall_piston;
            maxFirstLayerThickness 0.0005;
            allowDiscontinuity true;
        }
        "CYLINDERHEAD_WALL.*"
        {
            nLayers         $nLayers_wall_cylinderHead;
            maxFirstLayerThickness 0.0005;
            allowDiscontinuity true;
        }
        "VALVES_WALL_INTAKE.*"
        {
            nLayers         $nLayers_wall_valvesIntake;
            maxFirstLayerThickness 0.0005;
            allowDiscontinuity true;
        }
        "VALVES_WALL_EXHAUST.*"
        {
            nLayers         $nLayers_wall_valvesExhaust;
            maxFirstLayerThickness 0.0005;
            allowDiscontinuity true;
        }
        "VALVES_WALL_INTAKE_RIM"
        {
            nLayers         $nLayers_wall_intake_rim;
            maxFirstLayerThickness 0.0005;
            allowDiscontinuity true;
        }
        "VALVES_WALL_EXHAUST_RIM"
        {
            nLayers         $nLayers_wall_exhaust_rim;
            maxFirstLayerThickness 0.0005;
            allowDiscontinuity true;
        }
        "INLET.*|OUTLET.*|.*_SEAL"
        {
            nLayers         0;
            allowDiscontinuity true;
        }
    }
    optimiseLayer   false; // Very expensive, may fail -> worse mesh quality
}

renameBoundary
{
    nLayers 1;
    thicknessRatio 1.2;

    defaultType     patch;
    newPatchNames
    {
        ".*SLIP.*"
        {
            newName         "valveShafts";
            type            wall;
        }
        "CYLINDERHEAD_WALL_.*|SPARKPLUG_WALL.*|PRECHAMBER_WALL.*"
        {
            newName         "cylinderHead";
            type            wall;
        }
        "INJECTOR_WALL.*"
        {
            newName         "cylinderHead";
            type            wall;
        }
        "LINER_WALL_GASKET.*"
        {
            newName         "cylinderHead";
            type            wall;
        }
        "PISTON_WALL_.*"
        {
            newName         "piston";
            type            wall;
        }
        "VALVES_WALL_INTAKE_.*"
        {
            newName         "valvesIntake";
            type            wall;
        }
        "VALVES_WALL_EXHAUST_.*"
        {
            newName         "valvesExhaust";
            type            wall;
        }
        "LINER_WALL"
        {
            newName         "liner";
            type            wall;
        }
        "CYLINDERHEAD_INLET.*"
        {
            newName         "INLET";
            type            patch;
        }
        "CYLINDERHEAD_OUTLET.*"
        {
            newName         "OUTLET";
            type            patch;
        }
        "INJECTOR_INLET"
        {
            newName         "INLET_INJECTOR";
            type            patch;
        }
        "VALVES_WALL_INTAKE_SEAL|VALVES_WALL_EXHAUST_SEAL"
        {
            newName         "seal";
            type            wall;
        }
        "CYLINDERHEAD_SYMMETRY"
        {
            newName         "SYMMETRY";
            type            symmetry;
        }
    }
}

meshQualitySettings
{
    maxNonOrthogonality 65; // nonOrth. = 65, skew = 4: Good cfMesh performance and good QETR range
    maxSkewness 4;          // nonOrth. > 65: Bad QETR range due to high starting value
                            // skew < 4: Bad cfMesh/automatic remeshing perfomance due to frequent residual skew faces (badFaces)
}

workflowControls
{
