scale    1;

x0  0;
y0  0;
z0  0;
x1  0;
y1  0;
z1  0;

n_i 1;
n_j 1;
n_k 1;

vertices
(
    ($x0 $y0 $z0)
    ($x1 $y0 $z0)
    ($x1 $y1 $z0)
    ($x0 $y1 $z0)
    ($x0 $y0 $z1)
    ($x1 $y0 $z1)
    ($x1 $y1 $z1)
    ($x0 $y1 $z1)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($n_i $n_j $n_k) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    BOUNDARY
    {
        type patch;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (2 3 7 6)
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

mergePatchPairs
