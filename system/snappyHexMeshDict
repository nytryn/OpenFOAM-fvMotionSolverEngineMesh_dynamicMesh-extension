FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Which of the steps to run
castellatedMesh                 true;
snap                            true;
addLayers                       true;

geometry
{
    DOMAIN.stl
    {
        type                    triSurfaceMesh;
    }
    #include                    "./snappyHexMesh/geometry"
};

castellatedMeshControls
{
    maxLocalCells               20000000;
    maxGlobalCells              200000000;
    minRefinementCells          0;
    maxLoadUnbalance            0.10;
    nCellsBetweenLevels         3;

    features
    (
    );

    refinementSurfaces
    {
        #include                "./snappyHexMesh/refinementSurfaces"
    }

    resolveFeatureAngle         30;
    planarAngle                 10;

    refinementRegions
    {
        ".*WALL.*"
        {
            levels              (1 1);
        }
        #include                "./snappyHexMesh/refinementRegions"
    }

    limitRegions
    {
    }

    locationInMesh              (0 0 0);
    allowFreeStandingZoneFaces  false;
    locationsOutsideMesh        ((100 100 100));

}

snapControls
{
    nSmoothPatch                3;
    tolerance                   2.0;
    nSolveIter                  30;
    nRelaxIter                  5;
    nFeatureSnapIter            10;
    implicitFeatureSnap         false;
    explicitFeatureSnap         true;
    multiRegionFeatureSnap      false;
}

addLayersControls
{
    relativeSizes               true;
    expansionRatio              1.2;
    finalLayerThickness         0.5;
    minThickness                0.1;
    layers
    {
        #include                "./snappyHexMesh/layers"
    }
    nGrow                       0;
    featureAngle                150;
    maxFaceThicknessRatio       1000;
    nSmoothSurfaceNormals       1;
    nSmoothThickness            10;
    minMedialAxisAngle          180;
    maxThicknessToMedialRatio   0.3;
    nSmoothNormals              3;
    slipFeatureAngle            30;
    nRelaxIter                  5;
    nBufferCellsNoExtrude       0;
    nLayerIter                  15;
    nRelaxedIter                15;
    meshShrinker                displacementMediaAxis;
}


meshQualityControls
{
    #include                    "meshQualityDict"
    relaxed
    {
        maxNonOrtho             75;
        maxBoundarySkewness     20;
        maxInternalSkewness     8;
    }
    nSmoothScale                4;
    errorReduction              0.75;
    minTetQuality               -1;
}

mergeTolerance                  1e-6;

// ************************************************************************* //