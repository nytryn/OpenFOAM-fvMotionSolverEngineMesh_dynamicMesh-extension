stabilityBlendingFactor
{
    // Mandatory entries (unmodifiable)
    type                stabilityBlendingFactor;
    libs                (fieldFunctionObjects);

    // Mandatory entries (unmodifiable)
    field               U;
    result              UBlendingFactor; 

    // Optional entries (runtime modifiable)
    tolerance           0.001;

    // Any of the options can be chosen in combinations

    // Option-1
    switchNonOrtho      false;
    nonOrthogonality    nonOrthoAngle;
    maxNonOrthogonality 20;
    minNonOrthogonality 60;

    // Option-2
    switchGradCc        true;
    maxGradCc           3;
    minGradCc           4;

    // Option-3
    switchResiduals     false;
    maxResidual         10;
    residual            initialResidual:p;
    P                   1.5;
    I                   0;
    D                   0.5;

    // Option-4
    switchFaceWeight    false;
    maxFaceWeight       0.3;
    minFaceWeight       0.2;

    // Option-5
    switchSkewness      false;
    maxSkewness         2;
    minSkewness         3;

    // Option-6
    switchCo            true;
    U                   U;
    Co1                 0.0001;
    Co2                 0.01;

    // Optional (inherited) entries
    enabled             false;
    log                 true;
    executeControl      writeTime;
    executeInterval     1;
    writeControl        writeTime;
    writeFrequency      1;
}