sampling_probes
{
    type                probes;
    libs                ( "libsampling.so" );
    writeControl        timeStep;
    writeFrequency      1;
    fields              ( p U T rho );
    interpolationScheme cellPoint;
    interpolate         true;
    probeLocations      ( (0 0.001 0) );
    enabled             true;
}