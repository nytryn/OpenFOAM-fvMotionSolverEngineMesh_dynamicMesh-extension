FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

p_init  150000;
T_init  773;
#include "include/BOX.exhaust"

regions
(
    boxToCell
    {
        min $v0;
        max $v1;
        fieldValues
        (
            volScalarFieldValue p $p_init
            volScalarFieldValue T $T_init
	    );
    }
);

// ************************************************************************* //
