FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     NYTRO_engineFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         720;

deltaT          1e-3;

writeControl    adjustableRunTime;

writeFrequency  1;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  true;

maxCo           1;

deltaT_max       2e-02;

functions
{
    // Models and schemes
    #include "functions/passiveFuel"
    #include "functions/stabilityBlendingFactor"

    // Dimensionless numbers
    #include "functions/CourantNumber"
    #include "functions/MachNumber"
    #include "functions/PecletNumber"

    // Sampling
    #include "functions/sampling_areaNormalAverage_INLET"
    #include "functions/sampling_areaAverage_INLET"
    #include "functions/sampling_areaNormalAverage_INLET_INJECTOR"
    #include "functions/sampling_areaAverage_INLET_INJECTOR"
    #include "functions/sampling_areaNormalAverage_OUTLET"
    #include "functions/sampling_areaAverage_OUTLET"
    #include "functions/sampling_probes"
    #include "functions/sampling_fieldMinMax_U"
    #include "functions/sampling_fieldMinMax_p"
    #include "functions/sampling_fieldMinMax_T"
    #include "functions/sampling_fieldMinMax_rho"

    // Validation & verification results
    #include "functions/residuals"
    #include "functions/yPlus"
    #include "functions/momentumError"

    // Post-Processing
    #include "functions/solutionFormat_VTK"
    #include "functions/solutionFormat_Ensight"
}


