FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          fvOptions;
}


dampVelocity
{
    type            velocityDampingConstraint;
    selectionMode   all;
    UMax            3500;
}

limitTemperature    // Keep well within JANAF range, otherwise thermo might run
{                   // out of range or, if too tight, the jet can get disfigured 
                    // (inflated at exit etc.)
    type            limitTemperature;
    active          true;

    selectionMode   all;
    min             220;
    max             2750;
    //phase           air;
}

