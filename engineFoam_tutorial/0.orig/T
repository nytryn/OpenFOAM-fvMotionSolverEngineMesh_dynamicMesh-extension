FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    piston
    {
        type            fixedValue;
        value           uniform 300;
    }

    liner
    {
        type            fixedValue;
        value           uniform 300;
    }

    cylinderHead
    {
        type            fixedValue;
        value           uniform 300;
    }

    valveInlet
    {
        type            fixedValue;
        value           uniform 300;
    }
  
    valveOutlet
    {
        type            fixedValue;
        value           uniform 300;
    }

    inlet
    {
        type            fixedValue;
        value           uniform 300;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 300;
        value           uniform 300;

    }

    frontAndBack
    {
        type            empty;
    }
}


