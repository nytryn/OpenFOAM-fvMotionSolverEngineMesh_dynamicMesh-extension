FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101000;

boundaryField
{
    ".*"
    {
        type    zeroGradient;
    }

    INLET
    {
        type            totalPressure;
        gamma           1.4;
        psi             thermo:psi;
        //psi             none;
        p0              uniform 102000;
        value           uniform 102000;
    }

    OUTLET
    {
        type            totalPressure;
        gamma           1.4;
        psi             thermo:psi;
        //psi             none;
        p0              uniform 100000;
        value           uniform 100000;
    }

    SYMMETRY
    {
        type    symmetry;
    }
}

