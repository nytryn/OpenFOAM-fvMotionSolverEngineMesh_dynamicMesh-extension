FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-1;

boundaryField
{
    ".*"
    {
        type            nutkWallFunction;
        value           uniform 1e-1;
    }

    slipWalls
    {
        type            zeroGradient;
    }

    INLET_INJECTOR
    {
        type            calculated;
        value           uniform 1e-1;
    }

    INLET
    {
        type            calculated;
        value           uniform 1e-1;
    }

    OUTLET
    {
        type            inletOutlet;
        value           uniform 1e-1;
        inletValue      uniform 1e-1;
    }
    SYMMETRY
    {
        type    symmetry;
    }
}

