FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1e-2;

boundaryField
{
    ".*"
    {
        //type            kLowReWallFunction;
        //value           $internalField;
        type            zeroGradient;
    }

    slipWalls
    {
        type            zeroGradient;
    }

    INLET_INJECTOR
    {
        type            zeroGradient;
    }

    INLET
    {
        type            fixedValue;
        value           uniform 10;
    }

    OUTLET
    {
        type            inletOutlet;
        value           uniform 10;
        inletValue      uniform 10;
    }
    SYMMETRY
    {
        type    symmetry;
    }
}

