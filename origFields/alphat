FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 1e-1;

boundaryField
{
    ".*"
    {
        type            compressible::alphatWallFunction;
        value           uniform 1e-3;
    }

    slipWalls
    {
        type            zeroGradient;
    }

    INLET_INJECTOR
    {
        type            calculated;
        value           uniform 1e-1;
    }

    INLET
    {
        type            calculated;
        value           uniform 1e-1;
    }

    OUTLET
    {
        type            inletOutlet;
        value           uniform 1e-1;
        value           uniform 1e-1;
    }
    SYMMETRY
    {
        type            symmetry;
    }
}

