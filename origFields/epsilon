FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 1000;

boundaryField
{
    ".*"
    {
        // type            epsilonWallFunction;
        // lowReCorrection true;
        // blending        stepwise;
        // value           uniform 1000;
        type            zeroGradient;
    }

    slipWalls
    {
        type            zeroGradient;
    }


    INLET
    {
        type            fixedValue;
        value           uniform 1000;
    }

    INLET_INJECTOR
    {
        type            zeroGradient;
    }

    OUTLET
    {
        type            inletOutlet;
        value           uniform 1000;
        inletValue      uniform 1000;
    }
    SYMMETRY
    {
        type    symmetry;
    }
}

